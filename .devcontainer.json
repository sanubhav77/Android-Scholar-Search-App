{
    "name": "Distributed Systems Project 4",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:1": {}
    },
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "Tomcat / ScholarSearch",
            "visibility": "public"
        }
    },
    "postCreateCommand": "chmod +x build-and-run.sh",
    "postStartCommand": "bash build-and-run.sh"
}
